{
  "agents": {
    "defaults": {
      "workspace": "~/.nanobot/workspace",
      "model": "gemini-3.1-pro-preview",
      "provider": "custom",
      "maxTokens": 16384,
      "maxToolIterations": 120,
      "memoryWindow": 100,
      "reasoningEffort": null
    }
  },
  "channels": {
    "sendProgress": false,
    "sendToolHints": false,
    "test_bench": {
      "enabled": true,
      "base_url": "http://127.0.0.1:9999",
      "poll_timeout": 30,
      "allow_from": [
        "*"
      ]
    }
  },
  "providers": {
    "custom": {
      "apiKey": "__SET_BY_ENV__",
      "apiBase": "https://api.example.com/v1",
      "extraHeaders": null
    }
  },
  "gateway": {
    "host": "0.0.0.0",
    "port": 18790,
    "heartbeat": {
      "enabled": true,
      "intervalS": 1800
    }
  },
  "tools": {
    "web": {
      "proxy": "",
      "search": {
        "apiKey": "",
        "maxResults": 10
      }
    },
    "exec": {
      "timeout": 60,
      "pathAppend": ""
    },
    "restrictToWorkspace": false,
    "mcpServers": {
      "appworld": {
        "url": "http://127.0.0.1:10000/mcp",
        "headers": {
          "Accept": "application/json"
        }
      }
    }
  }
}
